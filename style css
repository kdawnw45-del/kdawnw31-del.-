/* Heading Styles */
.brand-title {
    color: #2c3e50;
    text-transform: uppercase;
    letter-spacing: 2px;
}

#main-subtitle {
    color: #e67e22;
    font-style: italic;
}

.collection-header {
    border-bottom: 2px solid #34495e;
    display: inline-block;
}

#contact-heading {
    color: #7f8c8d;
    font-size: 1.2rem;
}

/* Paragraph Styles */
.intro-text {
    font-family: 'Georgia', serif;
    line-height: 1.6;
}

#mission-statement {
    background-color: #f4f4f4;
    padding: 10px;
    border-left: 5px solid #2c3e50;
}

.fabric-details {
    color: #27ae60;
    font-weight: bold;
}

#seasonal-promo {
    text-align: center;
    border: 1px dashed #c0392b;
    padding: 10px;
}

.sustainability-focus {
    font-size: 0.9rem;
    color: #16a085;
}

#shipping-info {
    font-family: monospace;
    color: #8e44ad;
}
