/* Styling the Headings */
.brand-main {
    color: teal;
    font-size: 3rem;
    text-align: center;
    text-transform: uppercase;
}

#sub-brand {
    color: gold; 
    text-align: center;
    letter-spacing: 5px;
}

.section-title {
    border-bottom: 2px solid #333;
    padding-bottom: 10px;
}

#footer-note {
    color: scarletred;
    font-variant: small-caps;
}

/* Styling the 6 Paragraphs */
.intro-p {
    font-family: serif;
    font-size: 1.2rem;
    line-height: 1.8;
}

#mission-p {
    background-color: lavender;
    padding: 15px;
    border-left: 4px solid #d4af37;
}

.fabric-p {
    color: salmon;
}

#promo-p {
    text-align: center;
    border: 2px dashed #ff0000;
    margin: 20px 0;
}

.trend-p {
    font-family: sans-serif;
    color: beige;
}

#shipping-p {
    font-style: italic;
    color: azure;
}
